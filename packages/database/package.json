{
  "name": "@gt/database",
  "module": "src/index.ts",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./generated/prisma/browser.ts"
  },
  "scripts": {
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev --skip-generate",
    "db:push": "prisma db push",
    "db:seed": "tsx src/seed.ts",
    "dev": "tsup src/* --watch",
    "format": "prisma format",
    "generate": "prisma generate",
    "lint": "biome lint --write ./src/ && biome format --write ./src/",
    "studio": "prisma studio"
  },
  "devDependencies": {
    "@gt/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "prisma": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@upstash/redis": "catalog:",
    "dotenv": "17.2.3"
  }
}